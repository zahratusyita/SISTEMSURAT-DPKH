// Ganti SELURUH isi editor dbdiagram dengan file ini; jangan tambahkan ke definisi lama.
// Sumber: skema MySQL SIPAS aktual. Tidak mengandung data akun atau sesi.
Project SIPAS {
  database_type: 'MySQL'
  Note: 'Sistem Informasi Pengelolaan Administrasi Surat; relasi sesuai skema MySQL aktual.'
}

Table "surat_keluar" {
  "id" "bigint unsigned" [pk, not null, increment]
  "tanggal_keluar_surat" date [not null]
  "nomor_urut" varchar(255)
  "alamat_penerima" text
  "tanggal_surat" date [not null]
  "nomor_surat" varchar(255)
  "perihal" text [not null]
  "asal" varchar(255)
  "lampiran_path" varchar(255)
  "lampiran_nama_asli" varchar(255)
  "lampiran_mime" varchar(255)
  "lampiran_ukuran" "bigint unsigned"
  "created_at" timestamp
  "updated_at" timestamp
  "created_by" "bigint unsigned"
  "updated_by" "bigint unsigned"
  "surat_masuk_id" "bigint unsigned"

  Indexes {
    created_by [name: "surat_keluar_created_by_foreign"]
    updated_by [name: "surat_keluar_updated_by_foreign"]
    nomor_surat [name: "surat_keluar_nomor_surat_index"]
    surat_masuk_id [name: "surat_keluar_surat_masuk_id_foreign"]
    tanggal_keluar_surat [name: "surat_keluar_tanggal_keluar_surat_index"]
  }
}

Table "surat_masuk" {
  "id" "bigint unsigned" [pk, not null, increment]
  "tanggal_masuk_surat" date [not null]
  "nomor_urut" varchar(255)
  "alamat_pengirim" text
  "tanggal_surat" date [not null]
  "nomor_surat" varchar(255)
  "perihal" text [not null]
  "tujuan_disposisi" varchar(255)
  "lampiran_path" varchar(255)
  "lampiran_nama_asli" varchar(255)
  "lampiran_mime" varchar(255)
  "lampiran_ukuran" "bigint unsigned"
  "created_at" timestamp
  "updated_at" timestamp
  "created_by" "bigint unsigned"
  "updated_by" "bigint unsigned"

  Indexes {
    created_by [name: "surat_masuk_created_by_foreign"]
    updated_by [name: "surat_masuk_updated_by_foreign"]
    nomor_surat [name: "surat_masuk_nomor_surat_index"]
    tanggal_masuk_surat [name: "surat_masuk_tanggal_masuk_surat_index"]
  }
}

Table "users" {
  "id" "bigint unsigned" [pk, not null, increment]
  "name" varchar(255) [not null]
  "email" varchar(255) [not null]
  "email_verified_at" timestamp
  "password" varchar(255) [not null]
  "remember_token" varchar(100)
  "created_at" timestamp
  "updated_at" timestamp
  "deleted_at" timestamp

  Indexes {
    email [unique, name: "users_email_unique"]
  }
}

Ref "surat_keluar_created_by_foreign":"users"."id" < "surat_keluar"."created_by" [delete: restrict]

Ref "surat_keluar_surat_masuk_id_foreign":"surat_masuk"."id" < "surat_keluar"."surat_masuk_id" [delete: restrict]

Ref "surat_keluar_updated_by_foreign":"users"."id" < "surat_keluar"."updated_by" [delete: restrict]

Ref "surat_masuk_created_by_foreign":"users"."id" < "surat_masuk"."created_by" [delete: restrict]

Ref "surat_masuk_updated_by_foreign":"users"."id" < "surat_masuk"."updated_by" [delete: restrict]

